{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hookwire-api",
  "compatibility_date": "2025-08-03",
  "main": "./src/index.ts",
  "durable_objects": {
    "bindings": [
      { "name": "CHANNEL_DO", "class_name": "ChannelDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChannelDO"] }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true
    }
  }
}
