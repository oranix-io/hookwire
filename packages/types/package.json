{
  "name": "@hookwire/types",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@rslib/core": "^0.23.2",
    "typescript": "^7.0.2"
  }
}
